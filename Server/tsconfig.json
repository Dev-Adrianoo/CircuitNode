{
  "compilerOptions": {
     "rootDir": "./src",
       "outDir": "./dist",
    "module": "es2022",
    "target": "es2022" , 
    "moduleResolution": "node",
    "esModuleInterop":true ,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "baseUrl": "./src",
    "paths": {
       "@routes/*":["./modules/*"]
    },   
  },
  "include": [
    "src/**/*"
  ],
}
