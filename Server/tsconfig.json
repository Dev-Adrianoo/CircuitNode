{
  "compilerOptions": {
     "rootDir": "./src",
       "outDir": "./dist",

    "module": "es2022",
    "target": "esnext",
    "moduleResolution": "node",
    "esModuleInterop":true ,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "baseUrl": "./src",
    "paths": {
      "@routes": ["./routes"]
    },
  },
  "include": [
    "src/**/*"
  ],
}
