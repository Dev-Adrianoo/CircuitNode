FROM node:20-slim

WORKDIR /app

# Install necessary build tools for native modules
RUN apt-get update && apt-get install -y python3 make g++ build-essential && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY package*.json ./

# Install dependencies
# Using --legacy-peer-deps to avoid issues with dependency versions
RUN npm install --legacy-peer-deps

# Copy source files
COPY . .

# Expose the Vite port
EXPOSE 5173

# The command will be provided by docker-compose, but this is a good default
CMD ["npm", "run", "dev"]